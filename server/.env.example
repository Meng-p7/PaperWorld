# PaperWorld AI Core 环境变量示例
# 复制为 .env 后填写；.env 不会被提交到 git

# 监听端口（默认 8080）
PORT=8080

# 监听地址（默认 127.0.0.1，只允许本机访问）
# 只有把后端部署到容器/服务器、确实需要外部访问时才改成 0.0.0.0，
# 并且必须同时设置 PW_TOKEN，否则服务会拒绝启动。
HOST=127.0.0.1

# 后端访问令牌：设置后所有 /api/* 请求必须带 Authorization: Bearer <token>
# 生产环境强烈建议设置，否则任何能访问到这个端口的人都能调用你的模型额度
PW_TOKEN=

# 密钥加密主密钥（任意字符串，服务端会 sha256 后作为 AES-256-GCM 密钥）
# 不设置则首次启动时生成 server/data/master.key（仅适合本机开发）
PW_SECRET=

# 单次模型调用超时（毫秒，默认 45000）
PW_MODEL_TIMEOUT=45000
